# Copie para .env e preencha. NUNCA versione o .env real.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="app"
CORS_ORIGINS="*"
# URL pública do app (usada nos links dos e-mails: confirmação, redefinição de senha)
APP_URL=https://seu-dominio.com
# E-mail (Resend gerenciado pela Emergent) — a chave é provisionada pela plataforma
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=MotorCaixa
# EMAIL_REPLY_TO=contato@seu-dominio.com
# Segredo que o agendador envia em "Authorization: Bearer ..." (gere um valor aleatório longo)
WEBHOOK_CRON_SECRET=
APP_TZ=America/Sao_Paulo
# Em desenvolvimento local via http, use false (o cookie Secure só trafega em https)
COOKIE_SECURE=true
# Seed (opcional): credenciais do admin inicial
# SEED_ADMIN_EMAIL=admin@motorcaixa.com.br
# SEED_ADMIN_PASSWORD=troque-esta-senha
