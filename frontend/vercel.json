{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://motorcaixa.fastapicloud.dev/api/"
    },
    {
      "source": "/api/",
      "destination": "https://motorcaixa.fastapicloud.dev/api/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://motorcaixa.fastapicloud.dev/api/:path*"
    },
    {
      "source": "/((?!.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
